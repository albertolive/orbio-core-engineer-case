# Required for LLM, embeddings, and speech-to-text (gpt-transcribe).
OPENAI_API_KEY=

# OpenAI model for structured turn parsing and terminal summaries.
OPENAI_MODEL=gpt-5.6-luna

# Optional: enables ElevenLabs eleven_v4_turbo TTS via /v1/text-to-dialogue/stream.
# When omitted, the web UI falls back to browser speechSynthesis and displays a notice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=cjVigY5qzO86Huf0OWal
